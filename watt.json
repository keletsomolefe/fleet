{
  "$schema": "https://schemas.platformatic.dev/@platformatic/runtime/3.72.0.json",
  "autoload": {
    "path": "apps",
    "exclude": ["mobile"],
    "mappings": {
      "web": {
        "id": "web",
        "env": {
          "NITRO_HOST": "127.0.0.1",
          "NITRO_PORT": "0"
        }
      }
    }
  },
  "logger": {
    "level": "{PLT_SERVER_LOGGER_LEVEL}"
  },
  "server": {
    "hostname": "{PLT_SERVER_HOSTNAME}",
    "port": "{GATEWAY_PORT}"
  },
  "managementApi": "{PLT_MANAGEMENT_API}",
  "entrypoint": "gateway"
}
