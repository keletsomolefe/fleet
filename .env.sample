PLT_SERVER_LOGGER_LEVEL=info
PLT_MANAGEMENT_API=true
# Docker Desktop's Kratos login hook must reach the host gateway.
PLT_SERVER_HOSTNAME=0.0.0.0
GATEWAY_PORT=3042
# Public mobile API endpoint. Android development uses adb reverse.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3042/api

# Development services. pnpm dev:setup fills blank secrets in .env only.
POSTGRES_PORT=55432
POSTGRES_DB=fleet
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=
APP_DB_USER=fleet_app
APP_DB_PASSWORD=
KRATOS_DB_USER=fleet_kratos
KRATOS_DB_PASSWORD=
DATABASE_SCHEMA=app
DATABASE_URL=
KRATOS_DSN=

KRATOS_PORT=14433
KRATOS_ADMIN_PORT=14434
KRATOS_UI_PORT=14455
MAILPIT_PORT=18025
KRATOS_PUBLIC_URL=
KRATOS_ADMIN_URL=
KRATOS_UI_URL=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
KRATOS_UI_COOKIE_SECRET=
KRATOS_UI_CSRF_SECRET=

APP_URL=
APP_CSRF_SECRET=
KRATOS_HOOK_URL=
KRATOS_HOOK_SECRET=
BOOTSTRAP_ADMIN_EMAIL=patrickkeletso@gmail.com
BOOTSTRAP_ADMIN_FIRST_NAME=Patrick
BOOTSTRAP_ADMIN_LAST_NAME=Keletso
BOOTSTRAP_ADMIN_PASSWORD=
