PLT_SERVER_LOGGER_LEVEL=info
PLT_MANAGEMENT_API=true
# Docker Desktop's Kratos login hook must reach the host gateway.
PLT_SERVER_HOSTNAME=0.0.0.0
GATEWAY_PORT=3042
# Public mobile API endpoint. Android development uses adb reverse.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3042/api
MQTT_ENABLED=true
MQTT_WS_PORT=1884
MQTT_BIND_HOST=127.0.0.1
MQTT_PUBLIC_URL=ws://127.0.0.1:1884/mqtt

# Development services. pnpm dev:setup fills blank secrets in .env only.
POSTGRES_PORT=55432
POSTGRES_DB=fleet
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=
APP_DB_USER=fleet_app
APP_DB_PASSWORD=
KRATOS_DB_USER=fleet_kratos
KRATOS_DB_PASSWORD=
DATABASE_SCHEMA=app
DATABASE_URL=
KRATOS_DSN=

KRATOS_PORT=14433
KRATOS_ADMIN_PORT=14434
KRATOS_UI_PORT=14455
MAILPIT_PORT=18025
KRATOS_PUBLIC_URL=
KRATOS_ADMIN_URL=
KRATOS_UI_URL=
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
KRATOS_UI_COOKIE_SECRET=
KRATOS_UI_CSRF_SECRET=

APP_URL=
APP_CSRF_SECRET=
KRATOS_HOOK_URL=
KRATOS_HOOK_SECRET=
BOOTSTRAP_ADMIN_EMAIL=patrickkeletso@gmail.com
BOOTSTRAP_ADMIN_FIRST_NAME=Patrick
BOOTSTRAP_ADMIN_LAST_NAME=Keletso
BOOTSTRAP_ADMIN_PASSWORD=

# Absolute directory for private evidence and service job attachments.
FLEET_DATA_DIR=

# Service job provider alerts (Meta WhatsApp Cloud API)
SERVICE_JOB_ALERTS_ENABLED=false
SERVICE_JOB_ALERT_TRANSPORT=meta
OPENWA_DEMO_SENDER=
OPENWA_DEMO_RECIPIENTS=
OPENWA_DEMO_URL=
OPENWA_DEMO_SESSION_ID=
OPENWA_DEMO_API_KEY=
SERVICE_JOB_LINK_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_JOB_TEMPLATE=vhh_service_job_alert
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_API_VERSION=v25.0
# Optional override for local fake Graph servers.
META_WHATSAPP_GRAPH_URL=
# Public office number shown on provider job pages.
FLEET_CONTACT_PHONE=
