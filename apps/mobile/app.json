{
  "expo": {
    "name": "Fleet",
    "slug": "fleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fleet-app-icon.png",
    "scheme": "vhh-fleet",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vhhfleet.driver",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vhhfleet.driver",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/fleet-adaptive-icon.png",
        "monochromeImage": "./assets/brand/fleet-adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/fleet-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Fleet to record this truck’s route while you share location.",
          "locationAlwaysAndWhenInUsePermission": "Allow Fleet to record this truck’s route in the background while location sharing is on.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/fleet-mark.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
