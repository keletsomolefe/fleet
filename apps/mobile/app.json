{
  "expo": {
    "name": "VHH Fleet",
    "slug": "vhh-fleet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/vhh-monogram-4096.png",
    "scheme": "vhh-fleet",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vhhfleet.driver",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vhhfleet.driver",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/vhh-monogram-4096.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/vhh-monogram-4096.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/vhh-monogram-4096.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
