{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file=../../.env dist/main.js",
    "start:dev": "node --env-file=../../.env --import tsx --watch src/main.ts",
    "start:debug": "node --env-file=../../.env --inspect --import tsx --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "seed:admin": "node --env-file=../../.env --import tsx src/database/seed-admin.ts",
    "seed:admin:prod": "node dist/database/seed-admin.js",
    "configure:roles": "node --env-file=../../.env --import tsx src/database/configure-roles.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@platformatic/node": "^3.72.0",
    "aedes": "^1.2.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "1.1.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "main": "dist/watt.js"
}
