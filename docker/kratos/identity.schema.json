{
  "$id": "https://fleet.local/schemas/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fleet user",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "name": {
          "type": "object",
          "properties": {
            "first": { "type": "string", "title": "First name", "minLength": 1 },
            "last": { "type": "string", "title": "Last name", "minLength": 1 }
          },
          "required": ["first", "last"],
          "additionalProperties": false
        }
      },
      "required": ["email", "name"],
      "additionalProperties": false
    }
  },
  "required": ["traits"],
  "additionalProperties": false
}
