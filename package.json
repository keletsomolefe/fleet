{
  "name": "fleet",
  "scripts": {
    "dev": "wattpm dev",
    "build": "wattpm build",
    "start": "wattpm start",
    "test": "pnpm -r --filter '!mobile' --if-present test",
    "test:e2e": "pnpm --filter api test:e2e",
    "typecheck": "pnpm -r --filter '!mobile' --if-present typecheck",
    "dev:setup": "node scripts/setup-dev.mjs",
    "infra:up": "node scripts/setup-dev.mjs && docker compose up -d --wait --wait-timeout 180 && pnpm db:migrate && pnpm db:seed",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps -a",
    "infra:migrate": "docker compose run --rm kratos-migrate",
    "infra:test": "node scripts/test-dev-stack.mjs",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "pnpm --filter api seed:admin",
    "test:admin": "node scripts/test-admin-stack.mjs",
    "test:fleet": "node scripts/test-fleet-stack.mjs",
    "test:mobile": "node scripts/test-mobile-stack.mjs",
    "test:tracking-queue": "pnpm --filter api exec tsx ../../scripts/test-tracking-queue.mjs",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:build:staging": "pnpm --filter mobile exec pnpm dlx eas-cli@latest build --profile staging",
    "mobile:build:staging:local": "pnpm --filter mobile exec pnpm dlx eas-cli@latest build --profile staging --local",
    "mobile:check": "pnpm --filter mobile lint && pnpm --filter mobile typecheck",
    "mobile:test:startup": "node scripts/test-android-startup.mjs",
    "mobile:reverse": "node scripts/android-reverse.mjs",
    "test:schedules": "node scripts/test-schedules-stack.mjs",
    "test:issues": "node scripts/test-driver-issues-stack.mjs",
    "test:deployment": "node scripts/test-deploy-baseline.mjs",
    "test:downloads": "node scripts/test-android-download.mjs",
    "db:reset": "node scripts/reset-app-db.mjs",
    "test:activity-queue": "pnpm --filter api exec node --import tsx ../../scripts/test-activity-queue.mjs",
    "test:transport": "pnpm --filter api exec node --import tsx ../../scripts/test-transport-stack.mjs"
  },
  "dependencies": {
    "@platformatic/runtime": "^3.72.0",
    "platformatic": "^3.72.0",
    "wattpm": "^3.72.0"
  },
  "devDependencies": {
    "wattpm-utils": "^3.72.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
