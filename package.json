{
  "name": "fleet",
  "scripts": {
    "dev": "wattpm dev",
    "build": "wattpm build",
    "start": "wattpm start",
    "test": "npm run test --workspace api",
    "test:e2e": "npm run test:e2e --workspace api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:setup": "node scripts/setup-dev.mjs",
    "infra:up": "node scripts/setup-dev.mjs && docker compose up -d --wait --wait-timeout 180",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:status": "docker compose ps -a",
    "infra:migrate": "docker compose run --rm kratos-migrate",
    "infra:test": "node scripts/test-dev-stack.mjs"
  },
  "dependencies": {
    "@platformatic/runtime": "^3.72.0",
    "platformatic": "^3.72.0",
    "wattpm": "^3.72.0"
  },
  "devDependencies": {
    "wattpm-utils": "^3.72.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
